# Conexión a PostgreSQL desde la app (Next.js / Drizzle / seed).
# En pruebas: el servicio `db` del docker-compose. En local: tu Postgres.
# Formato: postgres://usuario:password@host:puerto/base
DATABASE_URL="postgres://siginex:change-me@localhost:5432/siginex"

# Credenciales de PostgreSQL que consume docker-compose (servicio db).
# El host `db` es el nombre del servicio dentro de la red de Docker.
POSTGRES_DB="siginex"
POSTGRES_USER="siginex"
POSTGRES_PASSWORD="change-me"

# Tenant que usa la UI web (fase 1, sin login de usuarios). Es el UUID del
# tenant creado por el seed. En fase 2 vendrá del usuario autenticado.
SIGINEX_TENANT_ID="00000000-0000-0000-0000-000000000000"

# NOTA: la autenticación de la API (endpoints /api) es por API key almacenada
# (tabla api_key), no por variable de entorno. Genera la primera con: npm run db:seed
